OPENAI_API_KEY=replace_with_your_server_side_key
OPENAI_MODEL=gpt-5.6-terra

# Keep the clinical endpoints private in production. Store the value only in Railway secrets.
CERAI_REQUIRE_ACCESS_KEY=1
CERAI_ACCESS_KEY=replace_with_a_long_random_access_key

# Operational safeguards; defaults shown here are already applied by the code.
CERAI_MAX_UPLOAD_FILES=16
CERAI_MAX_FILE_BYTES=12582912
CERAI_MAX_TOTAL_UPLOAD_BYTES=83886080
CERAI_MAX_JSON_REQUEST_BYTES=2097152
CERAI_GLOBAL_ANALYSIS_CONCURRENCY=2
CERAI_ANALYSIS_RATE_LIMIT=24
CERAI_ANALYSIS_RATE_WINDOW_SECONDS=900
CERAI_EXPOSE_API_DOCS=0

# Case archive staged rollout.
# Keep ENABLED=0 while the Railway Bucket, credentials and encryption key are being provisioned.
# After a non-PHI canary passes, set ENABLED=1 to activate archiving.
# Before production use, set REQUIRED=1 so a report is never released when archiving fails.
# REQUIRED=1 implicitly enables the archive even if ENABLED remains 0.
CERAI_ARCHIVE_ENABLED=0
CERAI_ARCHIVE_REQUIRED=0
# Base64 of exactly 32 random bytes; keep only as a Railway secret and back it up securely offline.
CERAI_ARCHIVE_MASTER_KEY_B64=replace_with_base64_encoded_32_random_bytes

# Railway Storage Bucket variable references. Railway can inject these from the Bucket resource.
BUCKET=replace_with_railway_bucket_api_name
ACCESS_KEY_ID=replace_with_bucket_access_key_id
SECRET_ACCESS_KEY=replace_with_bucket_secret_access_key
REGION=auto
ENDPOINT=https://storage.railway.app
# Use the URL style shown in the Railway Bucket Credentials tab: virtual or path.
AWS_S3_URL_STYLE=virtual
