OPENAI_API_KEY=replace_with_your_server_side_key
OPENAI_MODEL=gpt-5.6-terra

# Existing shared access-key gate. Named-user auth supersedes this gate when enabled.
CERAI_REQUIRE_ACCESS_KEY=1
CERAI_ACCESS_KEY=replace_with_a_long_random_access_key

# Named users are staged off by default. When enabled, configure only password hashes in the
# Railway secret; never store raw passwords. At least one enabled OWNER account is required.
CERAI_NAMED_USERS_ENABLED=0
CERAI_SESSION_TTL_SECONDS=43200
CERAI_MAX_USER_SESSIONS=256
CERAI_SESSION_COOKIE_SECURE=1
CERAI_LOGIN_FAILURE_LIMIT=10
CERAI_LOGIN_FAILURE_WINDOW_SECONDS=900
# Example structure only; generate each password_hash with scripts/generate_user_password_hash.py.
# CERAI_USERS_JSON=[{"user_id":"owner-1","username":"owner","display_name":"Owner","role":"OWNER","password_hash":"scrypt$...","enabled":true}]

# Operational safeguards; defaults shown here are already applied by the code.
CERAI_MAX_UPLOAD_FILES=16
CERAI_MAX_FILE_BYTES=12582912
CERAI_MAX_TOTAL_UPLOAD_BYTES=83886080
CERAI_MAX_JSON_REQUEST_BYTES=2097152
CERAI_GLOBAL_ANALYSIS_CONCURRENCY=2
CERAI_ANALYSIS_RATE_LIMIT=24
CERAI_ANALYSIS_RATE_WINDOW_SECONDS=900
CERAI_EXPOSE_API_DOCS=0

# Case archive staged rollout.
# Keep ENABLED=0 while the Railway Bucket, credentials and encryption key are being provisioned.
# First run: python scripts/verify_railway_archive_config.py
# Then run:  python scripts/verify_case_archive.py   (non-PHI encrypted canary)
# Only after both pass should ENABLED become 1.
# Before production use, set REQUIRED=1 so a report is never released when archiving fails.
# REQUIRED=1 implicitly enables the archive even if ENABLED remains 0.
CERAI_ARCHIVE_ENABLED=0
CERAI_ARCHIVE_REQUIRED=0
# Base64 of exactly 32 random bytes; keep only as a Railway secret and back it up securely offline.
CERAI_ARCHIVE_MASTER_KEY_B64=replace_with_base64_encoded_32_random_bytes

# Owner-only scientific CSV export. Keep disabled until named-user auth and archive are active.
# This is a separate secret from the archive master key, so a leaked CSV cannot be correlated to
# clinical case IDs without the dedicated research pseudonym secret.
CERAI_RESEARCH_EXPORT_ENABLED=0
CERAI_RESEARCH_PSEUDONYM_KEY_B64=replace_with_separate_base64_encoded_32_random_bytes

# Railway Storage Bucket variable references. Railway can inject these from the Bucket resource.
# IMPORTANT: BUCKET is the globally unique S3 API bucket name. Do not substitute RAILWAY_BUCKET_NAME.
BUCKET=replace_with_railway_bucket_api_name
ACCESS_KEY_ID=replace_with_bucket_access_key_id
SECRET_ACCESS_KEY=replace_with_bucket_secret_access_key
REGION=auto
ENDPOINT=replace_with_railway_bucket_credentials_endpoint
# Use the URL style shown in the Railway Bucket Credentials tab: virtual or path.
AWS_S3_URL_STYLE=virtual

# Future provider migration. The migration utility copies encrypted ciphertext and metadata without
# decrypting patient data. It is read-only by default; CERAI_MIGRATION_APPLY=1 must be explicit.
# Source would normally be the Railway bucket; destination can be any compatible Turkish S3 provider.
CERAI_MIGRATION_APPLY=0
CERAI_MIGRATION_SOURCE_BUCKET=replace_source_bucket
CERAI_MIGRATION_SOURCE_ENDPOINT=replace_source_s3_endpoint
CERAI_MIGRATION_SOURCE_ACCESS_KEY_ID=replace_source_access_key
CERAI_MIGRATION_SOURCE_SECRET_ACCESS_KEY=replace_source_secret_key
CERAI_MIGRATION_SOURCE_REGION=auto
CERAI_MIGRATION_SOURCE_URL_STYLE=virtual
CERAI_MIGRATION_DESTINATION_BUCKET=replace_destination_bucket
CERAI_MIGRATION_DESTINATION_ENDPOINT=replace_destination_s3_endpoint
CERAI_MIGRATION_DESTINATION_ACCESS_KEY_ID=replace_destination_access_key
CERAI_MIGRATION_DESTINATION_SECRET_ACCESS_KEY=replace_destination_secret_key
CERAI_MIGRATION_DESTINATION_REGION=auto
CERAI_MIGRATION_DESTINATION_URL_STYLE=virtual
